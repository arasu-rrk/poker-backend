{
  "name": "@planning-poker/database",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:seed": "pnpm --dir ../../apps/api exec wrangler d1 execute planning-poker --local --file=../../packages/database/src/seed.sql",
    "db:migrate:local": "pnpm --dir ../../apps/api exec wrangler d1 migrations apply planning-poker --local",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261122.2",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
