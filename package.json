{
  "name": "planning-poker-backend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev:api": "pnpm --filter @planning-poker/api dev",
    "dev:realtime": "pnpm --filter @planning-poker/realtime dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @planning-poker/database db:generate",
    "db:migrate:local": "pnpm --filter @planning-poker/database db:migrate:local",
    "db:seed": "pnpm --filter @planning-poker/database db:seed",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261122.2",
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.1",
    "globals": "^17.14.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
