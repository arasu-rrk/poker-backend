# API Worker
API_ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=info
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_CALLBACK_URL=http://localhost:8787/api/v1/auth/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_CLIENT_ID=
MICROSOFT_OIDC_CLIENT_SECRET=
MICROSOFT_OIDC_TENANT=common

# Realtime Worker
REALTIME_ALLOWED_ORIGINS=http://localhost:3000

# Bindings are configured in apps/api/wrangler.jsonc and apps/realtime/wrangler.jsonc.
